{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowJs": true,
    "skipLibCheck": true,
    "paths": {
      "@config/*": ["./src/config/*"],
      "@easyrpa/*": ["./src/apps/easyrpa/*"],
      "@fixtures/*": ["./src/fixtures/*"],
      "@api/*": ["./src/api/*"],
      "@factories/*": ["./src/factories/*"],
      "@easyrpa/support/*": ["./tests/easyrpa/bdd/support/*"],
      "@easyrpa/test-data/*": ["./tests/easyrpa/test-data/*"]
    }
  },
  "include": ["tests/**/*.ts", "src/**/*.ts", "config/**/*.ts", "src/fixtures/**/*.ts"]
}
