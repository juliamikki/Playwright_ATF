{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "node",
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowJs": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@config/*": ["src/config/*"],
      "@easyrpa/*": ["src/apps/easyrpa/*"],
      "@onliner/*": ["src/apps/onliner/*"],
      "@fixtures/*": ["src/fixtures/*"],
      "@api/*": ["src/api/*"],
      "@utils/*": ["src/utils/*"],
      "@easyrpa/support/*": ["tests/easyrpa/bdd/support/*"],
      "@easyrpa/test-data/*": ["tests/easyrpa/test-data/*"]
    }
  },
  "include": ["tests/**/*.ts", "src/**/*.ts", "config/**/*.ts", "src/fixtures/**/*.ts"]
}
