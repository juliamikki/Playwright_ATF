{
  "name": "playwright-atf",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "test": "playwright test --project=easyrpa-chrome",
    "test:crud": "playwright test tests/easyrpa/ui/ap.crud.test.ts --project=easyrpa-chrome",
    "test:crossbrowser": "playwright test --project=easyrpa-chrome --project=easyrpa-firefox --project=easyrpa-edge --project=easyrpa-webkit",
    "test:api": "playwright test --project=easyrpa-api",
    "test:contracts": "playwright test --project=easyrpa-contracts",
    "test:bdd": "cucumber-js --config cucumber.config.cjs --require-module tsx --format progress --format summary",
    "test:smoke": "cross-env HEADLESS=true playwright test --project=easyrpa-chrome --grep @smoke",
    "test:api:smoke": "playwright test --project=easyrpa-api --grep @smoke",
    "test:mobile:smoke": "cross-env HEADLESS=true playwright test --project=easyrpa-android --project=easyrpa-ios --grep @smoke",
    "report:playwright": "playwright show-report reports/playwright-report",
    "report:cucumber": "tsx generate-cucumber-report.ts && start reports/cucumber-html-report/index.html",
    "report:allure": "allure serve reports/allure-results",
    "report:allure:clean": "rimraf reports/allure-results",
    "clean:reports": "rimraf reports",
    "code:check": "eslint \"**/*.ts\"",
    "code:format": "prettier --write .",
    "prepare": "husky"
  },
  "keywords": [],
  "author": "Julia Shostak",
  "license": "MIT",
  "devDependencies": {
    "@cucumber/cucumber": "^12.7.0",
    "@cucumber/pretty-formatter": "^3.2.0",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^1.2.0",
    "@eslint/markdown": "^8.0.0",
    "@pact-foundation/pact": "^17.0.1",
    "@pact-foundation/pact-node": "^10.18.0",
    "@playwright/mcp": "^0.0.70",
    "@playwright/test": "^1.58.2",
    "@types/node": "^25.3.3",
    "allure-cucumberjs": "^3.6.0",
    "allure-playwright": "^3.6.0",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "eslint": "^10.1.0",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "jiti": "^2.6.1",
    "multiple-cucumber-html-reporter": "^3.10.0",
    "prettier": "^3.8.1",
    "rimraf": "^6.1.3",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.58.0"
  }
}
